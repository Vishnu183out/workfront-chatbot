OPENAI_API_KEY=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
OPENAI_MODEL=gpt-4o

# --- Workfront MCP server (defaults are correct as of this writing -
# only override if Adobe changes these) ---
WORKFRONT_MCP_ENDPOINT=https://mcp.workfront.adobe.com/mcp/v1/workfront
WORKFRONT_AUTHZ_ENDPOINT=https://mcp.workfront.adobe.com/oauth/authorize
WORKFRONT_TOKEN_ENDPOINT=https://mcp.workfront.adobe.com/oauth/token
WORKFRONT_REGISTRATION_ENDPOINT=https://mcp.workfront.adobe.com/mcp/v1/oauth/register
WORKFRONT_SCOPE=AdobeID openid profile email additional_info.projectedProductContext read_pc.workfront

# --- OAuth client for the shared bot account ---
# Leave both blank the FIRST time you run setup_bot_account.py - it will
# dynamically register a client and print these values for you to paste
# back in here, so future runs (and the server) reuse the same client
# instead of registering a new one every time.
WORKFRONT_CLIENT_ID=
WORKFRONT_CLIENT_SECRET=

# --- Redis (Upstash) - stores conversation sessions and per-user OAuth
# tokens. Required both locally and on Vercel (serverless has no
# persistent local filesystem/memory between requests). Free database at
# https://console.upstash.com - both values are on the database's detail
# page under "REST API" ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Used ONLY by register_oauth_client.py (one-time setup) - comma
# separated list of every redirect URL your app will ever run at, e.g.
# REDIRECT_URIS=http://localhost:8000/auth/callback,https://your-app.vercel.app/auth/callback
REDIRECT_URIS=http://localhost:8000/auth/callback,https://nontenantable-wearproof-easton.ngrok-free.dev/auth/callback

# --- Misc ---
TOOL_CACHE_TTL_SECONDS=3600
MAX_TOOL_ITERATIONS=8
